{
  "name": "github-listen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test",
    "build:web": "node scripts/build-web.mjs",
    "android:sync": "npm run build:web && cap sync android",
    "android:build": "npm run android:sync && node scripts/build-android.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9"
  }
}
